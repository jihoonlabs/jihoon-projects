APP_NAME=Ticket
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ACCOUNT.alwaysdata.net
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql-ACCOUNT.alwaysdata.net
DB_PORT=3306
DB_DATABASE=ACCOUNT_ticket_demo
DB_USERNAME=REPLACE_WITH_DEMO_DB_USER
DB_PASSWORD=REPLACE_ON_SERVER_ONLY

FRONTEND_URL=https://ACCOUNT.alwaysdata.net
SANCTUM_STATEFUL_DOMAINS=ACCOUNT.alwaysdata.net
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=60
SESSION_COOKIE=ticket_demo_session

CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
TICKET_DEMO_MODE=true

# デモはOAuth・メール認証を無効化。既存の秘密値は転記しない。
